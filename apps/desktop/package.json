{
  "name": "localtube",
  "version": "0.5.0",
  "private": true,
  "description": "Download YouTube videos and serve them to iPhone over local Wi-Fi",
  "bin": {
    "localtube": "dist-tsc/src/cli.js"
  },
  "repository": {
    "type": "git",
